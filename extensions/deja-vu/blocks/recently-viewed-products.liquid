<div
  class="recently-viewed"
  data-announcement-bar
  {% if block.settings.dismissible %}data-dismissible{% endif %}
  style="--announcement-bg: {{ block.settings.background.hex }}; --announcement-color: {{ block.settings.text_color.hex }}"
>
 Recently viewed
</div>

{% schema %}
{
  "label": "Hello",
  "target": "section",
  "javascript": "deja-vu.js",
  "stylesheet": "deja-vu.css",
  "settings": [
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "header",
      "content": "Product Cards"
    },
    {
      "type": "header",
      "content": "Carousel"
    }
  ]
}
{% endschema %}
