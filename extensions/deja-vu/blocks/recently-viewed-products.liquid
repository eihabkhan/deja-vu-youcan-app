<div
  class="recently-viewed"
  data-announcement-bar
  {% if block.settings.dismissible %}data-dismissible{% endif %}
  style="--announcement-bg: {{ block.settings.background.hex }}; --announcement-color: {{ block.settings.text_color.hex }}"
>
 Recently viewed
</div>

{% schema %}
{
  "label": "t:recently_viewed.label",
  "target": "section",
  "javascript": "deja-vu.js",
  "stylesheet": "deja-vu.css",
  "settings": [
    {
      "type": "header",
      "content": "t:recently_viewed.settings.colors.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:recently_viewed.settings.colors.background_color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:recently_viewed.settings.colors.text_color",
      "default": "#0e0d0d"
    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.layout.label"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "t:recently_viewed.settings.layout.heading_alignment.label",
      "options": [
          {
              "value": "start",
              "label": "t:recently_viewed.settings.layout.heading_alignment.start"
          },
          {
              "value": "center",
              "label": "t:recently_viewed.settings.layout.heading_alignment.center"
          }
      ],
      "default": "start"
    },
    {
      "type": "range",
      "id": "cards_gap",
      "min": 4,
      "max": 40,
      "step": 4,
      "unit": "px",
      "label": "t:recently_viewed.settings.layout.cards_gap",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "hide_current_product",
      "label": "t:recently_viewed.settings.layout.hide_current_product",
      "default": true
    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.typography.label"
    },
    {
      "type": "select",
      "id": "title_font_family",
      "label": "t:recently_viewed.settings.typography.title_font_family",
      "options": [
          {
              "value": "inherit",
              "label": "t:recently_viewed.settings.typography.inherit_from_theme"
          },
          {
              "value": "Inter",
              "label": "Inter"
          },
          {
              "value": "Roboto",
              "label": "Roboto"
          },
          {
              "value": "DM Sans",
              "label": "DM Sans"
          },
          {
