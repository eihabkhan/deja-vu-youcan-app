    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.product_cards.label"
    },
    {
      "type": "select",
      "id": "product_card_style",
      "label": "t:recently_viewed.settings.product_cards.style.label",
      "options": [
          {
            "value": "classic",
            "label": "t:recently_viewed.settings.product_cards.style.classic"
          },
          {
            "value": "modern",
            "label": "t:recently_viewed.settings.product_cards.style.modern"
          },
          {
            "value": "minimal",
            "label": "t:recently_viewed.settings.product_cards.style.minimal"
          }
      ],
      "default": "classic"
    },
    {
      "type": "range",
      "id": "product_card_border_radius",
      "label": "t:recently_viewed.settings.product_cards.border_radius",
      "min": 0,
      "max": 32,
      "step": 4,
      "unit": "px",
      "default": 12,
      "visible_if": {
        "setting_id": "product_card_style",
        "value": "minimal",
        "operator": "!="
      }
    },
    {
      "type": "select",
      "id": "product_card_image_ratio",
      "label": "t:recently_viewed.settings.product_cards.image_ratio",
      "options": [
          {
            "value": "1 / 1",
            "label": "1:1"
          },
          {
            "value": "3 / 4",
            "label": "3:4"
          },
          {
            "value": "2 / 3",
            "label": "2:3"
          },
          {
            "value": "4 / 5",
            "label": "4:5"
          }
      ],
      "default": "1 / 1"
    },
    {
      "type": "checkbox",
      "id": "show_product_price",
      "label": "t:recently_viewed.settings.product_cards.show_product_price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_compare_at_price",
      "label": "t:recently_viewed.settings.product_cards.show_compare_at_price",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_second_image_on_hover",
      "label": "t:recently_viewed.settings.product_cards.show_second_image_on_hover",
      "default": true
    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.carousel.label"
    },
    {
      "type": "range",
      "id": "per_page_desktop",
      "min": 0,
      "max": 6,
      "step": 1,
      "label": "t:recently_viewed.settings.carousel.per_page",
      "default": 4
    },
    {
      "type": "range",
      "id": "per_page_mobile",
      "min": 0,
      "max": 3,
      "step": 1,
      "label": "t:recently_viewed.settings.carousel.per_page_mobile",
      "default": 2
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "t:recently_viewed.settings.carousel.change_slide_every",
      "default": false
    },
    {
      "type": "range",
      "id": "change_slide_every",
      "min": 0,
      "max": 6,
      "step": 1,
      "unit": "s",
      "label": "t:recently_viewed.settings.carousel.change_slide_every",
      "default": 3
    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.spacing.label"
    },
    {
      "type": "select",
      "id": "spacing_unit",
      "label": "t:recently_viewed.settings.spacing.spacing_unit",
      "options": [
          {
              "value": "px",
              "label": "px"
          },
          {
              "value": "%",
              "label": "%"
          }
      ],
      "default": "px"
    },
    {
      "type": "range",
      "id": "vertical_spacing_px",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:recently_viewed.settings.spacing.vertical",
      "default": 24,
      "visible_if": {
        "setting_id": "spacing_unit",
        "value": "px"
      }
    },
    {
      "type": "range",
      "id": "horizontal_spacing_px",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:recently_viewed.settings.spacing.horizontal",
      "default": 24,
      "visible_if": {
        "setting_id": "spacing_unit",
        "value": "px"
      }
    },
    {
      "type": "range",
      "id": "vertical_spacing_percent",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "%",
      "label": "t:recently_viewed.settings.spacing.vertical",
      "default": 10,
      "visible_if": {
        "setting_id": "spacing_unit",
        "value": "%"
      }
    },
    {
      "type": "range",
      "id": "horizontal_spacing_percent",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "%",
      "label": "t:recently_viewed.settings.spacing.horizontal",
      "default": 10,
      "visible_if": {
        "setting_id": "spacing_unit",
        "value": "%"
      }
    }
  ]
