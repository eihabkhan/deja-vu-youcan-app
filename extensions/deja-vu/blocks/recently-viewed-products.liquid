<div
  class="recently-viewed"
  data-announcement-bar
  {% if block.settings.dismissible %}data-dismissible{% endif %}
  style="--announcement-bg: {{ block.settings.background.hex }}; --announcement-color: {{ block.settings.text_color.hex }}"
>
 Recently viewed
</div>

{% schema %}
{
  "label": "t:recently_viewed.label",
  "target": "section",
  "javascript": "deja-vu.js",
  "stylesheet": "deja-vu.css",
  "settings": [
    {
      "type": "header",
      "content": "t:recently_viewed.settings.spacing.label"
    },
    {
      "type": "select",
      "id": "spacing_unit",
      "label": "t:recently_viewed.settings.spacing.spacing_unit",
      "options": [
          {
              "value": "px",
              "label": "px"
          },
          {
              "value": "%",
              "label": "%"
          }
      ],
      "default": "px"
    },
    {
      "type": "range",
      "id": "vertical_spacing_px",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:recently_viewed.settings.spacing.vertical",
      "default": 24,
      "visible_if": {
        "setting_id": "spacing_unit",
        "value": "px"
      }
    },
    {
      "type": "range",
      "id": "horizontal_spacing_px",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "t:recently_viewed.settings.spacing.horizontal",
      "default": 24,
      "visible_if": {
        "setting_id": "spacing_unit",
        "value": "px"
      }
    },
    {
      "type": "range",
      "id": "vertical_spacing_percent",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "%",
      "label": "t:recently_viewed.settings.spacing.vertical",
      "default": 10,
      "visible_if": {
        "setting_id": "spacing_unit",
        "value": "%"
      }
    },
    {
      "type": "range",
      "id": "horizontal_spacing_percent",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "%",
      "label": "t:recently_viewed.settings.spacing.horizontal",
      "default": 10,
      "visible_if": {
        "setting_id": "spacing_unit",
        "value": "%"
      }
    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.colors.label"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:recently_viewed.settings.colors.background_color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:recently_viewed.settings.colors.text_color",
      "default": "#0e0d0d"
    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.layout.label"
    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.typography.label"
    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.product_cards.label"
    },
    {
      "type": "header",
      "content": "t:recently_viewed.settings.carousel.label"
    }
  ]
}
{% endschema %}
