              "label": "Noto Kufi Arabic"
          }
      ],
      "default": "inherit"
    },
    {
      "type": "select",
      "id": "body_font_family",
      "label": "t:recently_viewed.settings.typography.body_font_family",
      "options": [
          {
              "value": "inherit",
              "label": "t:recently_viewed.settings.typography.inherit_from_theme"
          },
          {
              "value": "Inter",
              "label": "Inter"
          },
