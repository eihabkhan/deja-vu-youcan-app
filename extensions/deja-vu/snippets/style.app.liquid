{% render 'style.typography' %}
{% render 'style.vars' %}

<style>
  deja-vu {
    padding: var(--vertical-spacing) var(--horizontal-spacing);
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: var(--heading-bottom-spacing);
    background-color: var(--bg-color);
    color: var(--text-color);

    &[data-dv-style="classic"] {
      --card-border-color: color-mix(in srgb, var(--text-color) 12%, transparent);
      --image-margin: 0px;
      --content-padding: 16px;
      --image-radius: 0px;

      .dv-product__images {
        border-inline: 0px !important;
        border-block-start: 0px !important;
      }
    }

    &[data-dv-style="modern"] {
      --card-border-color: color-mix(in srgb, var(--text-color) 12%, transparent);
      --image-margin: 8px;
      --content-padding: 8px;
      --image-radius: calc(var(--product-card-radius) - var(--image-margin));

      .dv-product__price {
        flex-direction: row !important;
        align-items: center;

        .dv-product__current-price {
          order: -1 !important;
        }
      }
    }

    &[data-dv-style="minimal"] {
    }

    &[data-dv-style="polaroid"] {
    }


    .dv-heading {
      display: flex;
      flex-direction: column;
      align-items: var(--heading-alignment);
      gap: var(--subheading-top-spacing);

      .dv-heading__title {
        {% unless block.settings.title_font_family == 'inherit' %}
          font-family: var(--title-font);
        {% endunless %}
        {% unless block.settings.title_size == 'inherit' %}
          font-size: var(--title-size);
        {% endunless %}
      }
  
      .dv-heading__subheading {
        {% unless block.settings.body_font_family == 'inherit' %}
          font-family: var(--body-font);
        {% endunless %}
        {% unless block.settings.subheading_size == 'inherit' %}
          font-size: var(--subheading-size);
        {% endunless %}
      }
    }

    .dv-main {
      .dv-product {
        --card-placeholder-bg: color-mix(in srgb, var(--text-color) 4%, transparent);
        --card-placeholder-fg: color-mix(in srgb, var(--text-color) 32%, white);
  
        display: flex;
        flex-direction: column;
        width: 300px;
        border-radius: var(--product-card-radius);
        overflow: hidden;
        border: 1px solid var(--card-border-color);
  
        .dv-product__images {
          margin: var(--image-margin) var(--image-margin) 0;
          display: flex;
          align-items: center;
          justify-content: center;
          background-color: var(--card-placeholder-bg);
          aspect-ratio: var(--product-card-ratio);
          border: 1px solid var(--card-border-color);
          color: var(--card-placeholder-fg);
          border-radius: var(--image-radius);
        }
  
        .dv-product__info {
          padding: var(--content-padding);
          display: flex;
          flex-direction: column;
          justify-content: space-between;
          gap: 16px;
  
          .dv-product__name,
          .dv-product__current-price,
          .dv-product__compare-at {
            {% unless block.settings.body_font_family == 'inherit' %}
              font-family: var(--body-font);
            {% endunless %}
            {% unless block.settings.body_size == 'inherit' %}
              font-size: var(--body-size);
            {% endunless %}
          }
  
          .dv-product__name {
            font-weight: 500;
            display: -webkit-box;
            -webkit-box-orient: vertical;
            -webkit-line-clamp: 3;
            line-clamp: 3;
            overflow: hidden;
          }
  
          .dv-product__price {
            display: flex;
            flex-direction: column;
            gap: 4px;
  
            .dv-product__current-price {
            }
  
            .dv-product__compare-at {
              font-size: 0.8em;
              text-decoration: line-through;
              opacity: 0.7;
            }
          }
        }
      }
    }
  }
</style>
